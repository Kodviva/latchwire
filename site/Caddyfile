:80 {
	root * /srv
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
	@html path / /index.html
	header @html Cache-Control "public, max-age=300"
	@assets path *.svg *.png *.txt *.xml
	header @assets Cache-Control "public, max-age=86400"
}
