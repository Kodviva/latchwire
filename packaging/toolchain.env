# Every version a release build depends on. Sourced by the build scripts and
# read by the GitHub workflows; change them here only.

# Go toolchain, exported as GOTOOLCHAIN=go$GO_VERSION.
GO_VERSION=1.25.14

# Linux build image (glibc, gcc). The digest pins the bytes behind the tag.
GOLANG_IMAGE=golang:1.25.14-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437

# Headers and linker name of libpcsclite in that image's Debian release.
PCSC_DEV_VERSION=1.9.9-2

# deb, rpm builder.
NFPM_VERSION=v2.48.0

# Oldest macOS the binary is built for.
MACOSX_DEPLOYMENT_TARGET=12.0

# Workflow linter, used by CI.
ACTIONLINT_VERSION=v1.7.12
