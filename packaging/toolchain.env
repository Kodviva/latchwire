# Build environment. The toolchain follows the latest stable releases on
# purpose: every build writes what it really used to BUILD-INFO, and that
# file is what rebuilds a release later (see packaging/README.md).

# Linux build image. The tag follows the latest Go. Bookworm stays for its
# glibc: the distribution of the image sets the oldest system the packages
# run on.
GOLANG_IMAGE=golang:bookworm

# Oldest macOS the binary runs on. It cannot go below what the Go release
# needs (macOS 13 for Go 1.27): the linker warns if it does.
MACOSX_DEPLOYMENT_TARGET=13.0
