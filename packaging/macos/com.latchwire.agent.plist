<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Latchwire user agent: holds the YubiKey and asks for its PIN (osascript
  dialog). Runs in each GUI login session as that user.
  Install: /Library/LaunchAgents/com.latchwire.agent.plist (root:wheel 0644).
  See docs/manual-install.md.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.latchwire.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/latchwire</string>
		<string>agent</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
